# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*.local
.env

# env example should be committed
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# testing
playwright-report/
test-results/

.claude/
*.memory.md

# 个人资料收集表：含隐私信息，仅本地保留，绝不提交
*.local.md
*.local.json
*.local.ps1
*.local.sh
*.local.ts

# 临时暂存目录（跨仓库搬运产物时使用，不属于本站源码）
.staging-*/

# logs
*.log
