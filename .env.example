# Personal Website Environment Variables
# Copy this file to .env.local and fill in your values

# --- Public site config ---
# Canonical site URL, used by metadata, robots.txt and sitemap.xml
NEXT_PUBLIC_SITE_URL=https://jtwzjn.icu

# --- GitHub data for project pages ---
# Personal access token (read-only) to avoid unauthenticated API rate limits.
# Optional: without it the GitHub cards simply fall back to a plain link.
GITHUB_TOKEN=

# --- Blog database (Neon PostgreSQL) ---
# Required for /blog and /admin. Without it database queries return empty rows.
POSTGRES_URL=

# --- Blog admin authentication (NextAuth GitHub OAuth) ---
# AUTH_GITHUB_ID / AUTH_GITHUB_SECRET come from a GitHub OAuth App.
# ADMIN_GITHUB_ID is the numeric GitHub user id allowed to sign in.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ADMIN_GITHUB_ID=
AUTH_SECRET=

# --- Blog cover image uploads (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=

# --- Error tracking (optional) ---
# Sentry is not wired into next.config.ts yet; leave empty unless you enable it.
NEXT_PUBLIC_SENTRY_DSN=
